  },
  "ebpf": {
    "bpf_obj_path": "bpf/xdp_filter.o",
    "auto_drop_enabled": true
  },
  "benchmarking": {
    "warmup_iterations": 100,
    "default_benchmark_events": 50000,
    "export_csv_path": "benchmark_results.csv"
  }
}