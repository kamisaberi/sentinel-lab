{
  "testbed": {
    "node_id": "sentinel-lab-workstation",
    "http_api_port": 8443,
    "ingest_port": 9000,
    "network_interface": "ens33"
  },
  "inference": {
    "backend": "OpenVINO",
    "model_path": "models/network_threat.onnx",
    "input_tensor_name": "input",
